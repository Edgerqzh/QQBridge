# Run npm run init to generate your own .env. Never commit .env.
QQBRIDGE_TOKEN=replace-with-at-least-32-random-characters
QQBRIDGE_BRIDGE_TOKEN=use-a-different-32-character-random-secret
QQBRIDGE_HOST=127.0.0.1
QQBRIDGE_PORT=5700
QQBRIDGE_BRIDGE_HOST=127.0.0.1
QQBRIDGE_BRIDGE_PORT=5711
# The Linux runtime script selects the experimental driver for the tested QQ build.
# compose.native.yaml includes a QQ runtime; plain compose.yaml is gateway-only.
QQBRIDGE_DRIVER=
# Optional installed QQ app resource directory for doctor/probe.
QQBRIDGE_QQ_APP=
# Optional separate native profile directory (default data/qq-profile).
QQBRIDGE_QQ_PROFILE=
# Empty selects QR login. An explicit account must already be cached and
# quick-login enabled in the same profile. No cached account is auto-selected.
QQBRIDGE_LOGIN_UIN=
# Optional comma-separated positive group IDs; empty permits joined groups.
QQBRIDGE_ALLOWED_GROUPS=
# Optional: connect to your own AI application's OneBot endpoint.
# Requires a separate token of at least 32 characters. Disabled when URL is empty.
QQBRIDGE_REVERSE_WS_URL=
QQBRIDGE_REVERSE_WS_TOKEN=

# Opt in only while testing rich media / mentions / recall; no live delivery validation yet.
QQBRIDGE_EXPERIMENTAL_RICH_MEDIA=0
